{
  "uid": "sdm-stakeholder",
  "title": "Service availability",
  "description": "Summary for one deployment: is it accessible, uptime, alarms.",
  "tags": [
    "soldevelo-monitoring",
    "stakeholder"
  ],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "deployment",
        "label": "Deployment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(probe_success, deployment)",
          "refId": "vars"
        },
        "refresh": 2,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(probe_success{deployment=\"$deployment\"}, environment)",
          "refId": "vars"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Is it accessible?",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Accessible now",
      "description": "Public URL probe from the monitoring host, every 15s.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Up",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "targets": [
        {
          "expr": "min by (environment) (probe_success{check=~\"public|\", deployment=\"$deployment\", environment=~\"$environment\"})",
          "instant": true,
          "legendFormat": "{{environment}}",
          "refId": "A"
        }
      ],
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "table",
      "title": "Uptime",
      "description": "Share of time the public URL answered. A period stays blank until monitoring has covered all of it.",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 16,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "custom": {
            "align": "center",
            "cellOptions": {
              "type": "color-text"
            }
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Environment"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Data since"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "md"
      },
      "targets": [
        {
          "expr": "avg_over_time((min by (environment) (probe_success{check=~\"public|\", deployment=\"$deployment\", environment=~\"$environment\"}))[1d:1m]) and on (environment) (min_over_time(timestamp(min by (environment) (probe_success{check=~\"public|\", deployment=\"$deployment\", environment=~\"$environment\"}))[1d:1h]) < time() - 79200)",
          "instant": true,
          "format": "table",
          "refId": "A"
        },
        {
          "expr": "avg_over_time((min by (environment) (probe_success{check=~\"public|\", deployment=\"$deployment\", environment=~\"$environment\"}))[7d:1m]) and on (environment) (min_over_time(timestamp(min by (environment) (probe_success{check=~\"public|\", deployment=\"$deployment\", environment=~\"$environment\"}))[7d:1h]) < time() - 597600)",
          "instant": true,
          "format": "table",
          "refId": "B"
        },
        {
          "expr": "avg_over_time((min by (environment) (probe_success{check=~\"public|\", deployment=\"$deployment\", environment=~\"$environment\"}))[30d:1m]) and on (environment) (min_over_time(timestamp(min by (environment) (probe_success{check=~\"public|\", deployment=\"$deployment\", environment=~\"$environment\"}))[30d:1h]) < time() - 2505600)",
          "instant": true,
          "format": "table",
          "refId": "C"
        },
        {
          "expr": "1000 * min_over_time(timestamp(min by (environment) (probe_success{check=~\"public|\", deployment=\"$deployment\", environment=~\"$environment\"}))[30d:1h])",
          "instant": true,
          "format": "table",
          "refId": "D"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "environment": "Environment",
              "Value #A": "Last 24 hours",
              "Value #B": "Last 7 days",
              "Value #C": "Last 30 days",
              "Value #D": "Data since"
            },
            "indexByName": {
              "environment": 0,
              "Value #D": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4
            }
          }
        }
      ],
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "barchart",
      "title": "Daily uptime",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 8
      },
      "interval": "1d",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "max": 1,
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0,
            "axisSoftMin": 0.95
          }
        }
      },
      "options": {
        "xField": "Time",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "showValue": "never",
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 100,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "avg_over_time((min by (environment) (probe_success{check=~\"public|\", deployment=\"$deployment\", environment=~\"$environment\"}))[1d:1m] offset -1d)",
          "legendFormat": "{{environment}}",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "Time",
            "mode": "outer"
          }
        },
        {
          "id": "formatTime",
          "options": {
            "timeField": "Time",
            "outputFormat": "MMM D",
            "useTimezone": true
          }
        }
      ],
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "timeFrom": "14d"
    },
    {
      "type": "state-timeline",
      "title": "Accessibility history",
      "description": "Green: up for the whole slot. Orange: down for part of it. Red: down for all of it.",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.0001
              },
              {
                "color": "green",
                "value": 0.9999
              }
            ]
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          }
        }
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "expr": "avg_over_time((min by (environment) (probe_success{check=~\"public|\", deployment=\"$deployment\", environment=~\"$environment\"}))[$__interval:1m])",
          "legendFormat": "{{environment}}",
          "refId": "A"
        }
      ],
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "row",
      "title": "Alarms",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Active critical alarms",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 4,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "targets": [
        {
          "expr": "count(ALERTS{alertstate=\"firing\", deployment=\"$deployment\", environment=~\"$environment\", severity=\"critical\"}) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Active warning alarms",
      "gridPos": {
        "x": 4,
        "y": 22,
        "w": 4,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "targets": [
        {
          "expr": "count(ALERTS{alertstate=\"firing\", deployment=\"$deployment\", environment=~\"$environment\", severity=\"warning\"}) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "table",
      "title": "Active alarms",
      "gridPos": {
        "x": 8,
        "y": 22,
        "w": 16,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Severity"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "color": "red",
                        "index": 0
                      },
                      "warning": {
                        "color": "orange",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Severity",
            "desc": false
          }
        ]
      },
      "targets": [
        {
          "expr": "ALERTS{alertstate=\"firing\", deployment=\"$deployment\", environment=~\"$environment\"}",
          "instant": true,
          "format": "table",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "environment": true,
              "severity": true,
              "alertname": true,
              "service": true
            },
            "indexByName": {
              "environment": 0,
              "severity": 1,
              "alertname": 2,
              "service": 3
            },
            "renameByName": {
              "environment": "Environment",
              "severity": "Severity",
              "alertname": "Alarm",
              "service": "Service"
            }
          }
        }
      ],
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "state-timeline",
      "title": "Alarm history",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "2": {
                  "text": "critical",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "warning",
                  "color": "orange",
                  "index": 1
                },
                "0": {
                  "text": "none",
                  "color": "green",
                  "index": 2
                }
              }
            }
          ]
        }
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "expr": "max_over_time(((2 * max by (environment) (ALERTS{alertstate=\"firing\", deployment=\"$deployment\", environment=~\"$environment\", severity=\"critical\"})) or max by (environment) (ALERTS{alertstate=\"firing\", deployment=\"$deployment\", environment=~\"$environment\", severity=\"warning\"}) or 0 * min by (environment) (probe_success{check=~\"public|\", deployment=\"$deployment\", environment=~\"$environment\"}))[$__interval:1m])",
          "legendFormat": "{{environment}}",
          "refId": "A"
        }
      ],
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Worst alarm firing per environment. Red: critical. Orange: warning. Green: none.",
      "interval": "5m"
    },
    {
      "type": "table",
      "title": "Alarms in selected period",
      "id": 11,
      "description": "How long each alarm fired in the selected time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Time firing"
            },
            "properties": [
              {
                "id": "unit",
                "value": "m"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Severity"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "color": "red",
                        "index": 0
                      },
                      "warning": {
                        "color": "orange",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Time firing",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "expr": "count_over_time((max by (environment, severity, alertname) (ALERTS{alertstate=\"firing\", deployment=\"$deployment\", environment=~\"$environment\"}))[$__range:1m])",
          "instant": true,
          "format": "table",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "environment": 0,
              "severity": 1,
              "alertname": 2,
              "Value": 3
            },
            "renameByName": {
              "environment": "Environment",
              "severity": "Severity",
              "alertname": "Alarm",
              "Value": "Time firing"
            }
          }
        }
      ]
    }
  ]
}
