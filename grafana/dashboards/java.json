{
  "uid": "sdm-java",
  "title": "JVM application",
  "tags": ["soldevelo-monitoring", "java", "jvm"],
  "schemaVersion": 39,
  "version": 2,
  "timezone": "browser",
  "time": { "from": "now-3h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "qryType": 1, "query": "label_values(jvm_memory_used_bytes, service)", "refId": "vars" },
        "refresh": 2,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "container",
        "label": "Container(s) for logs",
        "description": "Containers whose name matches the selected service. Adjust if your naming differs.",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "qryType": 1, "query": "label_values(container_last_seen{name=~\".*$service.*\"}, name)", "refId": "vars" },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*$service.*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Heap used (%)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.75 },
              { "color": "red", "value": 0.85 }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area" },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{service=\"$service\",area=\"heap\"}) / sum(jvm_memory_max_bytes{service=\"$service\",area=\"heap\"} > 0)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "GC overhead (last 5m)",
      "description": "Fraction of wall-clock time spent in GC. >25% means thrashing; OOM imminent.",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 0.25 }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area" },
      "targets": [
        {
          "expr": "sum(rate(jvm_gc_pause_seconds_sum{service=\"$service\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Live threads",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "expr": "jvm_threads_live_threads{service=\"$service\"}", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Process CPU",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 }
      },
      "options": { "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "expr": "process_cpu_usage{service=\"$service\"}", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Heap used vs max (bytes)",
      "description": "Used heap (filled area) against max heap (line). Steady creep upward in 'used' over hours is the classic leak signature.",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "fillOpacity": 30, "lineWidth": 1 }
        }
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{service=\"$service\",area=\"heap\"})",
          "legendFormat": "used",
          "refId": "A"
        },
        {
          "expr": "sum(jvm_memory_max_bytes{service=\"$service\",area=\"heap\"} > 0)",
          "legendFormat": "max",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Heap usage (%)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "fillOpacity": 20 }
        }
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{service=\"$service\",area=\"heap\"}) / sum(jvm_memory_max_bytes{service=\"$service\",area=\"heap\"} > 0)",
          "legendFormat": "heap %",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "GC pause time per second (cumulative)",
      "description": "Seconds of GC pause accumulated per second of wall time. 0.25 = 25% time in GC = thrashing.",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "sum by (action, cause) (rate(jvm_gc_pause_seconds_sum{service=\"$service\"}[5m]))",
          "legendFormat": "{{action}} ({{cause}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Avg GC pause duration",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "sum by (action) (rate(jvm_gc_pause_seconds_sum{service=\"$service\"}[5m])) / sum by (action) (rate(jvm_gc_pause_seconds_count{service=\"$service\"}[5m]))",
          "legendFormat": "{{action}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Memory by pool",
      "description": "Per-pool memory use. Steady growth in 'Old Gen' (G1: 'G1 Old Gen') signals a heap leak even when overall heap % looks OK due to GC pressure.",
      "gridPos": { "x": 0, "y": 19, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal", "group": "A" } }
        }
      },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{service=\"$service\"}",
          "legendFormat": "{{area}} / {{id}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Threads by state",
      "gridPos": { "x": 12, "y": 19, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal", "group": "A" } }
        }
      },
      "targets": [
        {
          "expr": "jvm_threads_states_threads{service=\"$service\"}",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Logs (from $container)",
      "description": "Loki logs from containers whose name contains the selected service. Adjust the container variable at the top if the auto-match doesn't line up with your naming.",
      "gridPos": { "x": 0, "y": 27, "w": 24, "h": 12 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": false, "dedupStrategy": "none" },
      "targets": [
        {
          "expr": "{container=~\"$container\"}",
          "refId": "A"
        }
      ]
    }
  ]
}
