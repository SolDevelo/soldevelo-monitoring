{
  "uid": "sdm-containers",
  "title": "Containers",
  "tags": ["soldevelo-monitoring", "containers"],
  "schemaVersion": 39,
  "version": 4,
  "timezone": "browser",
  "time": { "from": "now-3h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "qryType": 1, "query": "label_values(container_last_seen, environment)", "refId": "vars" },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] }
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "qryType": 1, "query": "label_values(container_last_seen, host)", "refId": "vars" },
        "refresh": 2,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "qryType": 1, "query": "label_values(container_last_seen{host=\"$host\",name!=\"\"}, name)", "refId": "vars" },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU per container (cores)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 30,
            "stacking": { "mode": "normal", "group": "A" },
            "lineWidth": 1
          }
        }
      },
      "targets": [
        {
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{host=\"$host\",environment=~\"$environment\",name=~\"$container\",name!=\"\"}[5m]))",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory per container",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 30,
            "stacking": { "mode": "normal", "group": "A" },
            "lineWidth": 1
          }
        }
      },
      "targets": [
        {
          "expr": "sum by (name) (container_memory_usage_bytes{host=\"$host\",environment=~\"$environment\",name=~\"$container\",name!=\"\"})",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Containers seen recently",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "count(time() - container_last_seen{host=\"$host\",environment=~\"$environment\",name!=\"\"} < 60)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Total memory in containers",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        {
          "expr": "sum(container_memory_usage_bytes{host=\"$host\",environment=~\"$environment\",name=~\"$container\",name!=\"\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Total CPU in containers (cores)",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 2 } },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{host=\"$host\",environment=~\"$environment\",name=~\"$container\",name!=\"\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Network in (rx) per container",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 30,
            "stacking": { "mode": "normal", "group": "A" },
            "lineWidth": 1
          }
        }
      },
      "targets": [
        {
          "expr": "sum by (name) (rate(container_network_receive_bytes_total{host=\"$host\",environment=~\"$environment\",name=~\"$container\",name!=\"\"}[5m]))",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Network out (tx) per container",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 30,
            "stacking": { "mode": "normal", "group": "A" },
            "lineWidth": 1
          }
        }
      },
      "targets": [
        {
          "expr": "sum by (name) (rate(container_network_transmit_bytes_total{host=\"$host\",environment=~\"$environment\",name=~\"$container\",name!=\"\"}[5m]))",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Logs (filtered by $host and $container variables)",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 12 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": false, "dedupStrategy": "none" },
      "targets": [
        {
          "expr": "{host=\"$host\",environment=~\"$environment\", container=~\"$container\"}",
          "refId": "A"
        }
      ]
    }
  ]
}
