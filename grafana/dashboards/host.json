{
  "uid": "sdm-host",
  "title": "Host overview",
  "tags": ["soldevelo-monitoring", "host"],
  "schemaVersion": 39,
  "version": 2,
  "timezone": "browser",
  "time": { "from": "now-3h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "qryType": 1, "query": "label_values(node_uname_info, environment)", "refId": "vars" },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] }
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "qryType": 1, "query": "label_values(node_uname_info, host)", "refId": "vars" },
        "refresh": 2,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU usage (%)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 }
      },
      "targets": [
        {
          "expr": "100 - (avg by (host) (rate(node_cpu_seconds_total{mode=\"idle\",host=\"$host\",environment=~\"$environment\"}[5m])) * 100)",
          "legendFormat": "cpu",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory usage (%)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 }
      },
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes{host=\"$host\",environment=~\"$environment\"} / node_memory_MemTotal_bytes{host=\"$host\",environment=~\"$environment\"})) * 100",
          "legendFormat": "memory",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Disk used (%)",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "100 - (node_filesystem_avail_bytes{host=\"$host\",environment=~\"$environment\",mountpoint=\"/\",fstype!~\"tmpfs|fuse.lxcfs\"} / node_filesystem_size_bytes{host=\"$host\",environment=~\"$environment\",mountpoint=\"/\"}) * 100",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Network per device (bytes/s, real NICs only)",
      "description": "Excludes loopback and Docker virtual interfaces (lo, docker*, veth*, br-*). Shows physical NIC traffic only — inter-container traffic stays on docker0/veth and is intentionally not counted here.",
      "gridPos": { "x": 8, "y": 8, "w": 16, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "targets": [
        {
          "expr": "rate(node_network_receive_bytes_total{host=\"$host\",environment=~\"$environment\",device!~\"lo|docker.*|veth.*|br-.*\"}[$__rate_interval])",
          "legendFormat": "{{device}} rx",
          "refId": "A"
        },
        {
          "expr": "rate(node_network_transmit_bytes_total{host=\"$host\",environment=~\"$environment\",device!~\"lo|docker.*|veth.*|br-.*\"}[$__rate_interval])",
          "legendFormat": "{{device}} tx",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Load average",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "node_load1{host=\"$host\",environment=~\"$environment\"}",  "legendFormat": "1m",  "refId": "A" },
        { "expr": "node_load5{host=\"$host\",environment=~\"$environment\"}",  "legendFormat": "5m",  "refId": "B" },
        { "expr": "node_load15{host=\"$host\",environment=~\"$environment\"}", "legendFormat": "15m", "refId": "C" }
      ]
    }
  ]
}
