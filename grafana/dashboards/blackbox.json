{
  "uid": "sdm-blackbox",
  "title": "HTTP probes",
  "tags": ["soldevelo-monitoring", "blackbox"],
  "schemaVersion": 39,
  "version": 2,
  "timezone": "browser",
  "time": { "from": "now-3h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "qryType": 1, "query": "label_values(probe_success, environment)", "refId": "vars" },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Probe success",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "DOWN", "color": "red" } }, "type": "value" },
            { "options": { "1": { "text": "UP",   "color": "green" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",   "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "targets": [
        { "expr": "probe_success{environment=~\"$environment\"}", "legendFormat": "{{instance}}", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Uptime % (selected time range)",
      "description": "Share of probes that succeeded over whatever range the time picker is set to — $__range follows it, so \"Last 3 hours\" gives 3h of uptime and \"Last 30 days\" gives 30d. Gaps count as neither up nor down: if the monitoring stack itself was down, that window is excluded rather than scored as an outage. Prometheus retention is 30d, so ranges longer than that only cover the part that still exists.",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 99 },
              { "color": "green",  "value": 99.9 }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "targets": [
        {
          "expr": "avg_over_time(probe_success{environment=~\"$environment\"}[$__range]) * 100",
          "legendFormat": "{{instance}}",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Probe duration",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "probe_duration_seconds{environment=~\"$environment\"}", "legendFormat": "{{instance}}", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Probe success (1=up, 0=down)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "min": 0, "max": 1 } },
      "targets": [
        { "expr": "probe_success{environment=~\"$environment\"}", "legendFormat": "{{instance}}", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "SSL certificate days remaining",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 14 },
              { "color": "green",  "value": 30 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "(probe_ssl_earliest_cert_expiry{environment=~\"$environment\"} - time()) / 86400",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    }
  ]
}
