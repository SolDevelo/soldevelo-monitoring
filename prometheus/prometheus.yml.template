global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    monitor: "${MONITORING_NAME}"

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]

rule_files:
  - /etc/prometheus/rules/*.yml

# App, host, and container metrics arrive via remote_write from the Alloy
# agents (receiver enabled with --web.enable-remote-write-receiver). The only
# scrape jobs are Prometheus itself and the blackbox HTTP probes.
scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: blackbox_http
    # Probe URLs come from JSON files in prometheus/targets/blackbox/*.json.
    # See docs/blackbox-setup.md.
    metrics_path: /probe
    params:
      module: [http_2xx]
    file_sd_configs:
      - files:
          - /etc/prometheus/targets/blackbox/*.json
        refresh_interval: 30s
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      # per-target module override via a `module` label in the target JSON
      - source_labels: [module]
        regex: (.+)
        target_label: __param_module
      - target_label: __address__
        replacement: blackbox:9115
      - regex: module
        action: labeldrop
