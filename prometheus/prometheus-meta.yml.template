global:
  scrape_interval: 60s
  evaluation_interval: 60s
  external_labels:
    monitor: "${MONITORING_NAME}-meta"

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: meta-node
    static_configs:
      # node-exporter runs in network_mode: host (so it can see real NICs),
      # so it's not on the Docker bridge — reach it via the host gateway.
      - targets: ["host.docker.internal:9101"]
        labels:
          host: "${MONITORING_NAME}"

  - job_name: meta-cadvisor
    static_configs:
      - targets: ["cadvisor:8080"]
        labels:
          host: "${MONITORING_NAME}"

  - job_name: meta-prometheus
    static_configs:
      - targets: ["prometheus:9090"]

  - job_name: meta-loki
    static_configs:
      - targets: ["loki:3100"]

  - job_name: meta-alertmanager
    static_configs:
      - targets: ["alertmanager:9093"]
