# Secrets / environment
.env

# Rendered configs (output of bin/render-configs.sh from *.template files)
/prometheus/prometheus.yml
/prometheus/prometheus-meta.yml
/alertmanager/alertmanager.yml
/caddy/Caddyfile

# Per-project overlay artifacts — committed in the project's own overlay, not
# in the base package. The dirs ship (via .gitkeep) as documented drop-zones;
# their contents stay out of the base.
/prometheus/targets/blackbox/*.json
/prometheus/rules/overlay/*.yml
/grafana/dashboards/overlay/*.json
!**/.gitkeep

# Per-deployment identity of the Kubernetes agent (copied from its .example)
/agents-alloy/kubernetes/30-agent-config.yaml

# Local editor / OS junk
.DS_Store
.idea/
.vscode/
