server:
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /tmp/positions.yaml

clients:
  - url: http://${MONITORING_SERVER_HOST}:${LOKI_PUSH_PORT}/loki/api/v1/push

scrape_configs:
  - job_name: docker
    docker_sd_configs:
      - host: unix:///var/run/docker.sock
        refresh_interval: 5s
    relabel_configs:
      # Drop the monitoring stack's own containers — operational noise, and
      # log-pattern rules would otherwise feedback-loop on the ruler's own
      # logs (e.g. an OutOfMemoryError rule matching Loki's logs about the
      # rule). Compose names: soldevelo-monitoring-*.
      - source_labels: ["__meta_docker_container_name"]
        regex: "/soldevelo-monitoring-.*"
        action: drop

      - source_labels: ["__meta_docker_container_name"]
        regex: "/(.*)"
        target_label: "container"

      - source_labels: ["__meta_docker_container_log_stream"]
        target_label: "stream"

      - target_label: "host"
        replacement: "${TARGET_NAME}"

  - job_name: varlogs
    static_configs:
      - targets:
          - localhost
        labels:
          job: varlogs
          host: "${TARGET_NAME}"
          __path__: /var/log/*.log
