# soldevelo-monitoring — copy to .env and fill in.
# Used by docker compose AND by bin/render-configs.sh to expand *.template files.
#
# The stack side and the agent side use different subsets of these variables.
# On a shared machine (local testing) one .env holds everything. On separate
# machines (monitoring host vs. target host), each has its own .env with only
# the variables it needs.

# ============================================================================
# STACK SIDE — used on the monitoring host
# ============================================================================

# ----- Image versions (pin for reproducibility) -----
PROMETHEUS_VERSION=v2.55.1
ALERTMANAGER_VERSION=v0.27.0
LOKI_VERSION=2.9.10
GRAFANA_VERSION=11.3.0
BLACKBOX_VERSION=v0.25.0
CADDY_VERSION=2.8-alpine
# node-exporter + cAdvisor for the monitor's own self-monitoring.
NODE_EXPORTER_VERSION=v1.8.2
CADVISOR_VERSION=v0.49.1

# ----- Monitoring host identity & public URL -----
# Short slug for this monitor deployment; surfaces in alerts and dashboards.
MONITORING_NAME=sdd-monitoring

# Public URL of the monitoring site (used by Caddy as the listen address, by
# Grafana as its root URL, and by Alertmanager in Slack alert links).
# Examples:
#   http://localhost                → local testing, plain HTTP
#   http://localhost:8080           → local testing on a non-default Caddy port
#   localhost                       → local testing with Caddy's self-signed TLS
#   https://monitoring.example.com  → production: Caddy auto-provisions Let's Encrypt
MONITORING_SITE=http://localhost

# Used only when MONITORING_SITE is a real domain — Let's Encrypt registers
# this for cert lifecycle notifications.
LETSENCRYPT_EMAIL=admin@example.com

# Caddy listen ports on the host. Defaults are standard 80/443; remap if
# something else on the host is already bound there (e.g. another web app).
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# ----- Grafana admin -----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# ----- Alerting (Slack) -----
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME/HERE
SLACK_CHANNEL=#monitoring-test

# Optional: separate channel for environment="prod" alerts. Both default to the
# values above when unset, so single-environment deployments need neither.
#SLACK_WEBHOOK_URL_PROD=
#SLACK_CHANNEL_PROD=

# ----- Remote ingest (agents pushing from other deployments) -----
# Bearer token Caddy checks on <MONITORING_SITE>/ingest/*. Generate:
#   openssl rand -hex 32
# See docs/remote-push-setup.md.
INGEST_TOKEN=changeme-generate-with-openssl-rand-hex-32

# ----- Metrics ingest & blackbox probes -----
# App, host, and container metrics arrive via remote_write from the Alloy
# agents — nothing is registered here. The only scrape targets are blackbox
# HTTP probe URLs, as JSON under prometheus/targets/blackbox/ (hot-reloaded
# every 30s). See docs/blackbox-setup.md.

# ============================================================================
# AGENT SIDE — used on each target host that runs agents-alloy/docker-compose.yml
# ============================================================================

ALLOY_VERSION=v1.5.1

# Identity stamped on all metrics and logs from this host (see docs/metrics.md).
# TARGET_NAME becomes the `host` label — must be set, or host/container
# dashboards go blank.
APP=cfp-classifier
DEPLOYMENT=sdd
TARGET_NAME=cfp-classifier

# Central ingest endpoints (bearer-gated Caddy paths on the monitoring host).
INGEST_METRICS_URL=https://sdd-monitoring.soldevelo.com/ingest/prometheus/api/v1/write
INGEST_LOGS_URL=https://sdd-monitoring.soldevelo.com/ingest/loki/loki/api/v1/push
# Same secret as INGEST_TOKEN in the stack section.
INGEST_TOKEN=changeme-generate-with-openssl-rand-hex-32
