global:
  resolve_timeout: 5m
  slack_api_url: "${SLACK_WEBHOOK_URL}"

route:
  receiver: slack
  group_by: ["alertname", "host"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 6h
  routes:
    - matchers:
        - severity="critical"
      receiver: slack
      group_wait: 10s

receivers:
  - name: slack
    slack_configs:
      - channel: "${SLACK_CHANNEL}"
        send_resolved: true
        title: '[{{ .Status | toUpper }}{{ if eq .Status "firing" }} x {{ .Alerts.Firing | len }}{{ end }}] {{ .CommonLabels.alertname }}'
        text: |
          {{ range .Alerts -}}
          *{{ .Labels.severity | toUpper }}* — {{ .Annotations.summary }}
          {{ .Annotations.description }}
          <${MONITORING_SITE}|open grafana>
          {{ end }}
