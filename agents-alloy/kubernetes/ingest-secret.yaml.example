# Shape of the Secret the Deployment reads. Create it out-of-band instead of
# committing a filled copy:
#   kubectl create secret generic alloy-ingest -n monitoring \
#     --from-literal=INGEST_TOKEN='<INGEST_TOKEN from the monitoring host .env>'
# Deliberately not *.yaml: `kubectl apply -f <dir>/` skips it, so it can never
# overwrite the real token with the placeholder.
apiVersion: v1
kind: Secret
metadata:
  name: alloy-ingest
  namespace: monitoring
type: Opaque
stringData:
  INGEST_TOKEN: REPLACE_WITH_INGEST_TOKEN
